# --- OS ---
.DS_Store

# --- Env / secrets ---
.env
.env.*
# The template is documentation, not a secret: without this negation the two
# lines above would hide the one file a fresh clone needs.
!.env.example
*.local

# --- Frontend build output (webapp-zendent/.gitignore also applies) ---
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.tanstack/
.vinxi/
.wrangler/

# --- Backend build output (api/.gitignore also applies) ---
target/
build/

# --- Claude Code local (machine-specific) settings ---
.claude/settings.local.json

# --- Skill registry cache ---
.atl/.skill-registry.cache.json
