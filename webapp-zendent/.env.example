# Copy to `.env` — that file is git-ignored and yours alone.
#
# Development only. The backend listens on its own port locally, while in
# production the API is served under the same host as the app, under `/api`
# (docs/adr/0017-api-served-under-each-clinic-subdomain.md). Only the port is
# overridden here; the clinic label in the hostname is carried through
# untouched, because the host is what tells the API which clinic you are.
#
# Leave it unset to get the production arrangement (same origin, `/api`).
ZENDENT_API_PORT=8080
